{
  "manifest_version": 3,
  "name": "Vitalis",
  "version": "1.4.0",
  "description": "Vitalis para Chrome: avisos de agenda y sociales con sonido en cualquier pestaña, botón en el CRM (Trade24Seven y Novara Markets) para pasar ventas, registro de clientes new y snippets con /atajo.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "scripting",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vitaliscrm.netlify.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://crmnovaramarkets.com/*",
        "https://*.crmnovaramarkets.com/*",
        "https://crmtrade24seven.com/*",
        "https://*.crmtrade24seven.com/*"
      ],
      "js": [
        "crm.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "snip.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Vitalis",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
